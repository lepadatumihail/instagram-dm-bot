# Copy to .env for local runs. On Railway, set the same names under Variables.

# Meta app → Use cases → API setup with Unified login → step 2 "Generate token"
# for your account. A system-user token ("EAA…") never expires. An older
# Instagram-login token ("IG…") lasts 60 days, and the bot refreshes it weekly.
IG_ACCESS_TOKEN=

# The account's id, shown next to it in step 2. Needed with a system-user token.
IG_USER_ID=

# App settings → Basic → App secret: Meta signs every webhook with it.
# IG_APP_SECRET is the "Instagram app secret" of apps made before Unified
# login; either one is accepted.
META_APP_SECRET=
IG_APP_SECRET=

# Any random string. Paste the same one in the app's webhook settings.
IG_VERIFY_TOKEN=

# Any random string. Protects /admin/pending, /admin/backfill and /admin/stats.
ADMIN_KEY=

# Shown on /privacy: the contact address, the account's handle (no @), who
# runs it and their site, and where the bot is hosted. Read /privacy once it
# is up: it is published under your name.
CONTACT_EMAIL=
IG_USERNAME=
OWNER_NAME=
OWNER_URL=
HOSTING_PROVIDER=Railway

# Where the SQLite file lives. On Railway: /data/bot.db, with a volume at /data.
DB_PATH=./data/bot.db

# How often to look for keyword comments the webhook missed. 0 turns it off.
SWEEP_MINUTES=10

# Reply "Hey @name, DM sent 📩" under each answered comment. "off" turns it off.
PUBLIC_REPLIES=on

# Where your giveaway notes live, for `npm run giveaways`.
GIVEAWAYS_DIR=giveaways

# Optional: failures also go to a Telegram chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
